// =====================================
// RECEPCION DE PACIENTES
// =====================================
model ModalidadCita {
  id        Int      @id @default(autoincrement())
  codigo    String   @unique @db.VarChar(40)
  nombre    String   @db.VarChar(100)
  estado    Boolean  @default(true)
