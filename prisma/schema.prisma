// =====================================
// NUEVO: CARGOS DOCENTES (Usuario)
// =====================================
model CargoDocente {
  id     Int     @id @default(autoincrement())
  codigo String? @db.VarChar(20)
  nombre String  @db.Text
  estado Boolean @default(true)

  usuarios                   Usuario[]
  historialesLaboralesOrigen HistorialLaboralOrigen[]

  @@unique([nombre])
  @@index([codigo])
  @@map("cargos_docentes")
}

// =====================================
// NUEVO: ESPECIALIDADES MÉDICAS (Empleado)
// =====================================
model EspecialidadMedica {
  id     Int     @id @default(autoincrement())
  codigo String? @db.VarChar(20)
  nombre String  @db.VarChar(150)
  estado Boolean @default(true)

  empleados EmpleadoEspecialidad[]
  citas     Cita[]

  @@unique([nombre])
  @@index([codigo])
  @@map("especialidades_medicas")
}

model EmpleadoEspecialidad {
  id             Int @id @default(autoincrement())
  empleadoId     Int
  especialidadId Int

  principal Boolean @default(false)

  empleado     Empleado           @relation(fields: [empleadoId], references: [id], onDelete: Cascade)
  especialidad EspecialidadMedica @relation(fields: [especialidadId], references: [id], onDelete: Restrict)

  @@unique([empleadoId, especialidadId])
  @@index([empleadoId])
  @@index([especialidadId])
  @@map("empleado_especialidades")
}

// =====================================
// PAISES
// =====================================
model Pais {
  codigo         String @id @db.Char(3)
  nombre         String @db.VarChar(100)
  codigoTelefono String @db.Char(3)

  usuariosResidencia Usuario[] @relation("PaisResidencia")

  @@map("paises")
}

// =====================================
// DEPARTAMENTOS
// =====================================
model Departamento {
  codigo String @id @db.Char(2)
  nombre String @db.VarChar(50)

  municipios     Municipio[]            @relation("DepartamentoMunicipios")
  usuarios       Usuario[]              @relation("DepartamentoUsuarios")
  eps            Eps[]                  @relation("DepartamentoEps")
  centrosMedicos CentroMedico[]         @relation("DepartamentoCentroMedico")
  sedes          Sede[]                 @relation("DepartamentoSedes")
  instituciones  InstitucionEducativa[] @relation("DepartamentoInstituciones")

  @@map("departamentos")
}

// =====================================
// MUNICIPIOS
// =====================================
model Municipio {
  codigo             String @id @db.Char(5)
  nombre             String @db.VarChar(100)
  codigoDepartamento String @db.Char(2)

  departamento Departamento @relation("DepartamentoMunicipios", fields: [codigoDepartamento], references: [codigo])

  usuarios       Usuario[]              @relation("MunicipioUsuarios")
  eps            Eps[]                  @relation("MunicipioEps")
  barrios        Barrio[]               @relation("MunicipioBarrios")
  centrosMedicos CentroMedico[]         @relation("MunicipioCentroMedico")
  sedes          Sede[]                 @relation("MunicipioSedes")
  instituciones  InstitucionEducativa[] @relation("MunicipioInstituciones")

  @@index([codigoDepartamento])
  @@map("municipios")
}

// =====================================
// BARRIOS
// =====================================
model Barrio {
  id              Int    @id @default(autoincrement())
  nombre          String @db.VarChar(100)
  codigoMunicipio String @db.Char(5)

  localidad    String? @db.VarChar(100)
  codigoPostal String? @db.VarChar(10)
  comuna       String? @db.VarChar(50)

  municipio Municipio @relation("MunicipioBarrios", fields: [codigoMunicipio], references: [codigo])

  usuarios Usuario[] @relation("BarrioUsuarios")

  @@unique([codigoMunicipio, nombre])
  @@index([codigoMunicipio])
  @@map("barrios")
}

// =====================================
// EPS
// =====================================
model Eps {
  codigo             String  @id @db.VarChar(6)
  nombreEntidad      String  @db.VarChar(255)
  codigoDepartamento String? @db.Char(2)
  codigoMunicipio    String? @db.Char(5)
  digitado           Boolean @default(false)
  nit                String  @unique @db.VarChar(15)
  dv                 String  @db.Char(1)
  email              String  @db.VarChar(80)
  telefono           String  @db.VarChar(15)
  direccion          String  @db.VarChar(100)

  departamento Departamento? @relation("DepartamentoEps", fields: [codigoDepartamento], references: [codigo])
  municipio    Municipio?    @relation("MunicipioEps", fields: [codigoMunicipio], references: [codigo])

  usuarios Usuario[] @relation("EpsUsuarios")

  @@index([codigoDepartamento])
  @@index([codigoMunicipio])
  @@map("eps")
}

// =====================================
// CENTRO MÉDICO
// =====================================
model CentroMedico {
  id                 Int     @id @default(autoincrement())
  codigoHabilitacion String  @db.VarChar(255)
  nombre             String  @db.VarChar(255)
  email              String? @db.VarChar(100)
  direccion          String? @db.VarChar(100)
  telefono           String? @db.VarChar(20)
  codigoDepartamento String? @db.Char(2)
  codigoMunicipio    String? @db.Char(5)
  logo               Bytes?
  estado             Int     @default(1) @db.SmallInt
  resolucion         String? @db.VarChar(50)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  createdBy String?  @db.VarChar(100)
  updatedBy String?  @db.VarChar(100)

  departamento Departamento? @relation("DepartamentoCentroMedico", fields: [codigoDepartamento], references: [codigo])
  municipio    Municipio?    @relation("MunicipioCentroMedico", fields: [codigoMunicipio], references: [codigo])

  sedes Sede[]

  @@index([codigoDepartamento])
  @@index([codigoMunicipio])
  @@map("centro_medico")
}

// =====================================
// SEDES
// =====================================
model Sede {
  id                 Int     @id @default(autoincrement())
  centroMedicoId     Int
  nombre             String  @db.VarChar(100)
  codigoHabilitacion String? @db.VarChar(50)
  direccion          String? @db.VarChar(225)
  codigoDepartamento String? @db.Char(2)
  codigoMunicipio    String? @db.Char(5)
  telefono           String? @db.VarChar(50)
  estado             Int     @default(1) @db.SmallInt

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  createdBy String?  @db.VarChar(100)
  updatedBy String?  @db.VarChar(100)

  centroMedico CentroMedico @relation(fields: [centroMedicoId], references: [id])

  departamento Departamento? @relation("DepartamentoSedes", fields: [codigoDepartamento], references: [codigo])
  municipio    Municipio?    @relation("MunicipioSedes", fields: [codigoMunicipio], references: [codigo])

  usuarios           Usuario[]             @relation("SedeUsuarios")
  empleados          Empleado[]            @relation("SedeEmpleados")
  dictamenes         Dictamen[]            @relation("SedeDictamenes")
  notificadores      SedeNotificador[]
  horariosLaborales  HorarioLaboral[]
  generacionesAgenda GeneracionAgenda[]
  cuposMedicos       CupoMedico[]
  citas              Cita[]
  receptionPolicies  ReceptionSitePolicy[]

  @@index([centroMedicoId])
  @@index([codigoDepartamento])
  @@index([codigoMunicipio])
  @@map("sedes")
}

model SedeNotificador {
  id         Int @id @default(autoincrement())
  sedeId     Int
  empleadoId Int

  estado       Boolean   @default(true)
  vigenteDesde DateTime? @map("vigente_desde") @db.Date
  vigenteHasta DateTime? @map("vigente_hasta") @db.Date

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  createdBy String?  @db.VarChar(100)
  updatedBy String?  @db.VarChar(100)

  sede     Sede     @relation(fields: [sedeId], references: [id], onDelete: Cascade)
  empleado Empleado @relation("EmpleadoNotificadoresSede", fields: [empleadoId], references: [id], onDelete: Cascade)

  @@unique([sedeId, empleadoId])
  @@index([sedeId])
  @@index([empleadoId])
  @@index([estado])
  @@index([vigenteDesde, vigenteHasta])
  @@map("sede_notificadores")
}

// =====================================
// SECRETARÍAS DE EDUCACIÓN
// =====================================
model Secretaria {
  id     Int    @id @default(autoincrement())
  nombre String @db.VarChar(150)

  usuarios      Usuario[]              @relation("SecretariaUsuarios")
  instituciones InstitucionEducativa[] @relation("SecretariaInstituciones")

  @@map("secretarias")
}

// =====================================
// INSTITUCIONES EDUCATIVAS
// =====================================
model InstitucionEducativa {
  id     Int    @id @default(autoincrement())
  nombre String @db.VarChar(150)

  idDepartamento String? @map("id_departamento") @db.Char(2)
  idMunicipio    String? @map("id_municipio") @db.Char(5)
  idSecretaria   Int?    @map("id_secretaria")

  codigoIed String? @map("codigo_ied") @db.VarChar(20)

  direccion String? @db.VarChar(255)

  departamento Departamento? @relation("DepartamentoInstituciones", fields: [idDepartamento], references: [codigo])
  municipio    Municipio?    @relation("MunicipioInstituciones", fields: [idMunicipio], references: [codigo])
  secretaria   Secretaria?   @relation("SecretariaInstituciones", fields: [idSecretaria], references: [id])

  usuarios                   Usuario[]                @relation("InstitucionUsuarios")
  historialesLaboralesOrigen HistorialLaboralOrigen[]

  @@index([idDepartamento])
  @@index([idMunicipio])
  @@index([idSecretaria])
  @@map("instituciones_educativas")
}

// =====================================
// PERFILES
// =====================================
model Perfil {
  id     Int    @id @default(autoincrement())
  nombre String @unique @db.VarChar(100)
  estado Int    @default(1) @db.SmallInt

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  createdBy String?  @db.VarChar(100)
  updatedBy String?  @db.VarChar(100)

  empleados Empleado[]
  permisos  PerfilPermiso[]

  @@map("perfiles")
}

// =====================================
// USUARIOS
// =====================================
model Usuario {
  id Int @id @default(autoincrement())

  carnet             String @db.VarChar(50)
  identificacion     String @db.VarChar(20)
  tipoIdentificacion String @db.Char(2)

  primerApellido  String  @db.VarChar(50)
  segundoApellido String? @db.VarChar(50)
  primerNombre    String  @db.VarChar(50)
  segundoNombre   String? @db.VarChar(50)

  direccion   String? @db.VarChar(255)
  telefono    String? @db.VarChar(15)
  tipoUsuario String  @db.Char(2)

  codigoOcupacion String? @db.Char(4)

  cargoDocenteId Int?          @map("cargo_docente_id")
  cargoDocente   CargoDocente? @relation(fields: [cargoDocenteId], references: [id])

  unidadEdad String @db.Char(1)
  edad       Int?   @db.SmallInt

  sexo String @db.Char(1)

  residenciaPais String @db.Char(3)
  paisResidencia Pais   @relation("PaisResidencia", fields: [residenciaPais], references: [codigo])

  zonaResidencia String @db.Char(1)

  fechaNacimiento DateTime? @db.Date

  estadoCivil String?       @db.VarChar(20)
  estado      EstadoUsuario @default(ACTIVO)
  fechaEstado DateTime?     @db.Date

  sector String @db.VarChar(50)

  nombreAcudiente   String? @db.VarChar(100)
  telefonoAcudiente String? @db.VarChar(15)
  hemoclasificacion String? @db.VarChar(3)
  parentezco        String? @db.Char(1)

  discapacidad Boolean @default(false)
  estrato      Int?    @db.SmallInt

  codigoEps String @db.VarChar(6)
  eps       Eps    @relation("EpsUsuarios", fields: [codigoEps], references: [codigo])

  categoria       String? @db.VarChar(30)
  etnia           String? @db.VarChar(10)
  lugarNacimiento String? @db.VarChar(5)

  nroHijos    Int     @default(0) @db.SmallInt
  escolaridad String? @db.Text

  fechaVinculacion DateTime? @map("fecha_vinculacion") @db.Date
  fechaAfiliacion  DateTime  @default(now())

  celular            String? @db.VarChar(15)
  email              String? @db.VarChar(100)
  profileVersion     Int     @default(0)
  religion           String? @db.VarChar(50)
  telefonoSecundario String? @db.VarChar(15)

  createdAt DateTime @default(now())
  createdBy String?  @db.VarChar(100)
  updatedAt DateTime @updatedAt
  updatedBy String?  @db.VarChar(100)

  genero    String? @db.VarChar(20)
  gestacion Boolean @default(false)

  victimaConflictoArmado Boolean @default(false)
  victimaMaltrato        Boolean @default(false)
  abandonoSocial         Boolean @default(false)
  desescolarizado        Boolean @default(false)
  desempleado            Boolean @default(false)
  carcelario             Boolean @default(false)
  migrante               Boolean @default(false)
  trabajadoraSexual      Boolean @default(false)
  poblacionLgtbi         Boolean @default(false)

  orientacionSexual String @default("NO REFIERE") @db.VarChar(50)

  barrio String? @db.VarChar(50)

  barrioId  Int?
  barrioRef Barrio? @relation("BarrioUsuarios", fields: [barrioId], references: [id])

  confirmacionTelefono ConfirmacionTelefono @default(SIN_CONFIRMAR)

  codigoDepartamento String? @db.Char(2)
  codigoMunicipio    String? @db.Char(5)
  codigoPais         String  @default("057") @db.Char(3)

  idSede Int?
  sede   Sede? @relation("SedeUsuarios", fields: [idSede], references: [id])

  gradoEscalafon   String @db.VarChar(2)
  nivelEscalafon   String @db.VarChar(1)
  formaVinculacion String @db.VarChar(45)

  secretariaId  Int?
  secretariaRef Secretaria? @relation("SecretariaUsuarios", fields: [secretariaId], references: [id])

  institucionEducativaId  Int?
  institucionEducativaRef InstitucionEducativa? @relation("InstitucionUsuarios", fields: [institucionEducativaId], references: [id])

  departamento Departamento? @relation("DepartamentoUsuarios", fields: [codigoDepartamento], references: [codigo])
  municipio    Municipio?    @relation("MunicipioUsuarios", fields: [codigoMunicipio], references: [codigo])

  dictamenes                Dictamen[]
  versionesFormularioOrigen VersionFormularioOrigen[] @relation("UsuarioSnapshotFormularioOrigen")
  recomendacionesLaborales  RecomendacionLaboral[]    @relation("UsuarioRecomendacionesLaborales")
  citas                     Cita[]

  @@unique([identificacion, tipoIdentificacion])
  @@index([codigoEps])
  @@index([codigoDepartamento])
  @@index([codigoMunicipio])
  @@index([email])
  @@index([cargoDocenteId])
  @@index([idSede])
  @@map("usuarios")
}

// =====================================
// EMPLEADOS
// =====================================
model Empleado {
  id Int @id @default(autoincrement())

  tipoDocumento   String? @db.VarChar(3)
  numeroIdentidad String? @db.VarChar(18)
  usuario         String  @db.VarChar(50)

  primerNombre    String  @db.VarChar(40)
  segundoNombre   String? @db.VarChar(40)
  primerApellido  String  @db.VarChar(40)
  segundoApellido String? @db.VarChar(40)

  direccion String? @db.VarChar(50)
  telefonos String? @db.VarChar(30)

  contrasena String? @db.VarChar(60)

  activo Boolean @default(true)

  registroMedico String? @db.VarChar(25)
  licencia       String? @db.VarChar(30)

  tratamiento TratamientoProfesional @default(DR) @map("tratamiento")

  perfilId Int?
  perfil   Perfil? @relation(fields: [perfilId], references: [id])

  firma     Bytes?
  firmaMime String? @map("firma_mime") @db.VarChar(50)

  esMiembroJunta Boolean @default(false) @map("es_miembro_junta")

  email  String? @db.VarChar(50)
  idSede Int?
  sede   Sede?   @relation("SedeEmpleados", fields: [idSede], references: [id])

  especialidades     EmpleadoEspecialidad[]
  sedesNotificador   SedeNotificador[]               @relation("EmpleadoNotificadoresSede")
  horariosLaborales  HorarioLaboral[]                @relation("HorarioLaboralMedico")
  generacionesAgenda GeneracionAgendaMedico[]        @relation("GeneracionAgendaMedicoEmpleado")
  exclusionesAgenda  GeneracionAgendaFechaExcluida[] @relation("GeneracionAgendaExclusionMedico")
  cuposMedicos       CupoMedico[]                    @relation("CupoMedicoEmpleado")

  dictamenes                   Dictamen[]                  @relation("EmpleadoDictamenesResponsable")
  dictamenesReabiertos         Dictamen[]                  @relation("EmpleadoReaberturasDictamenes")
  historialDictamenes          DictamenHistorial[]         @relation("EmpleadoHistorialDictamenes")
  dictamenJunta                DictamenJunta[]
