  updatedAt DateTime @updatedAt

  citas Cita[]

  @@map("modalidades_cita")
}

model Cita {
  id                      Int                @id @default(autoincrement())
  usuarioId               Int
  cupoMedicoId            Int
  sedeId                  Int
  medicoId                Int
  especialidadId          Int
  modalidadId             Int
  inicioProgramado        DateTime           @db.Timestamptz(3)
  finProgramado           DateTime           @db.Timestamptz(3)
  sedeNombre              String             @db.VarChar(100)
  medicoNombre            String             @db.VarChar(180)
  especialidadNombre      String             @db.VarChar(150)
  modalidadNombre         String             @db.VarChar(100)
  medioSolicitud          MedioSolicitudCita
  estado                  EstadoCita         @default(ASIGNADA)
  activadaAt              DateTime?          @db.Timestamptz(3)
  activadaBy              Int?
  clinicalEncounterSource String?            @db.VarChar(80)
  clinicalEncounterId     String?            @db.VarChar(120)
  citaOrigenId            Int?
  lockVersion             Int                @default(0)
  createdAt               DateTime           @default(now())
  createdBy               Int
  updatedAt               DateTime           @updatedAt
  updatedBy               Int

  paciente           Usuario            @relation(fields: [usuarioId], references: [id], onDelete: Restrict)
  cupoMedico         CupoMedico         @relation(fields: [cupoMedicoId], references: [id], onDelete: Restrict)
  sede               Sede               @relation(fields: [sedeId], references: [id], onDelete: Restrict)
  medico             Empleado           @relation("CitaMedico", fields: [medicoId], references: [id], onDelete: Restrict)
  especialidad       EspecialidadMedica @relation(fields: [especialidadId], references: [id], onDelete: Restrict)
  modalidad          ModalidadCita      @relation(fields: [modalidadId], references: [id], onDelete: Restrict)
  creadoPor          Empleado           @relation("CitaCreadaPor", fields: [createdBy], references: [id], onDelete: Restrict)
  citaOrigen         Cita?              @relation("CitaReprogramacion", fields: [citaOrigenId], references: [id], onDelete: Restrict)
  citasReprogramadas Cita[]             @relation("CitaReprogramacion")
  historial          CitaHistorial[]
  documentos         DocumentoCita[]

  @@unique([clinicalEncounterSource, clinicalEncounterId])
  @@index([usuarioId, inicioProgramado])
  @@index([usuarioId, estado, inicioProgramado])
  @@index([cupoMedicoId])
  @@index([citaOrigenId])
  @@map("citas")
}

model CitaHistorial {
