}

// =====================================
// DICTAMEN
// =====================================
model Dictamen {
  id                        Int                  @id @default(autoincrement())
  usuarioId                 Int
  numeroDictamen            String?              @db.VarChar(30)
  fechaDictamen             DateTime             @db.Date
  creadoEn                  DateTime             @default(now())
  updatedAt                 DateTime             @updatedAt
  procedimientoPcl          ProcedimientoPcl
  flujoVersion              FlujoDictamenVersion @default(LEGACY) @map("flujo_version")
  operacionId               String?              @unique @map("operacion_id") @db.Uuid
  pclIniciadoEn             DateTime?            @map("pcl_iniciado_en")
  pclRequiereRevision       Boolean              @default(false) @map("pcl_requiere_revision")
  origenVersionUtilizadaPcl Int?                 @map("origen_version_utilizada_pcl")
  lockVersion               Int                  @default(1) @map("lock_version")

  tipoDictamen TipoDictamen @default(CALIFICACION) @map("tipo_dictamen")

  totalTitulo1           Decimal?                @db.Decimal(6, 2)
  totalCap1              Decimal?                @db.Decimal(6, 2)
  claseLimitacionLaboral ClaseLimitacionLaboral?
  totalCap2              Decimal?                @db.Decimal(6, 2)
  totalTitulo3           Decimal?                @db.Decimal(6, 2)

  antecedentesClinicos String?
  condicionSalud       String?
  descripcionHallazgos String?

  sustentacionObservaciones String? @db.Text

  fechaEstructuracionInvalidez DateTime?
  tipoEvento                   DictamenTipoEvento?
  origenEvento                 DictamenOrigenEvento?

  aplicaAnalisisOcupacional Boolean @default(false)
  estado                    Boolean @default(true)
  reabierto                 Boolean @default(false)

  reabiertoEn        DateTime? @map("reabierto_en")
  reabiertoPorId     Int?      @map("reabierto_por_id")
  motivoReaperturaId Int?      @map("motivo_reapertura_id")

  empleadoId Int?
  empleado   Empleado? @relation("EmpleadoDictamenesResponsable", fields: [empleadoId], references: [id])

  sedeId Int?
  sede   Sede? @relation("SedeDictamenes", fields: [sedeId], references: [id])

  reabiertoPor     Empleado?         @relation("EmpleadoReaberturasDictamenes", fields: [reabiertoPorId], references: [id])
  motivoReapertura MotivoReapertura? @relation("MotivoReaperturaActualDictamen", fields: [motivoReaperturaId], references: [id])

  usuario Usuario @relation(fields: [usuarioId], references: [id])

  diagnosticos        DictamenDiagnostico[]
  deficiencias        DictamenDeficiencia[]
  limitacionesAvdAivd DictamenLimitacionesAvdAivd[]
  analisisOcupacional DictamenAnalisisOcupacional[]

  junta            DictamenJunta[]
  historial        DictamenHistorial[]
  formularioOrigen FormularioOrigen?

  @@index([usuarioId])
  @@index([empleadoId])
  @@index([sedeId])
  @@index([reabiertoPorId])
  @@index([motivoReaperturaId])
  @@index([tipoDictamen])
  @@index([estado, reabierto, fechaDictamen])
  @@index([flujoVersion])
  @@map("dictamenes")
}

model FormularioOrigen {
  id                    Int                    @id @default(autoincrement())
  dictamenId            Int                    @unique @map("dictamen_id")
  estado                EstadoFormularioOrigen @default(BORRADOR)
  formatoVersion        String                 @default("BORRADOR-INSTITUCIONAL-1") @map("formato_version") @db.VarChar(50)
  versionActual         Int                    @default(1) @map("version_actual")
  lockVersion           Int                    @default(1) @map("lock_version")
  fechaDictamenOrigen   DateTime               @map("fecha_dictamen_origen") @db.Date
  numeroDictamenOrigen  String?                @map("numero_dictamen_origen") @db.VarChar(40)
  descripcion           String?                @db.Text
  actividadExtralaboral String?                @map("actividad_extralaboral") @db.Text
  fechaOcurrencia       DateTime?              @map("fecha_ocurrencia") @db.Date
  horaOcurrencia        DateTime?              @map("hora_ocurrencia") @db.Time(0)
  jornadaEvento         JornadaEvento?         @map("jornada_evento")
  tratamiento           String?                @db.Text
  concepto              String?                @db.Text
  fundamentosDerecho    String?                @map("fundamentos_derecho") @db.Text
  tipoEvento            DictamenTipoEvento?    @map("tipo_evento")
  origenEvento          DictamenOrigenEvento?  @map("origen_evento")
  createdAt             DateTime               @default(now()) @map("created_at")
  updatedAt             DateTime               @updatedAt @map("updated_at")
  finalizadoEn          DateTime?              @map("finalizado_en")
  finalizadoPorId       Int?                   @map("finalizado_por_id")
  reabiertoEn           DateTime?              @map("reabierto_en")
  reabiertoPorId        Int?                   @map("reabierto_por_id")

