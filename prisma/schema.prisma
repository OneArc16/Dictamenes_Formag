// =====================================
// CATÁLOGO DE DEFICIENCIAS
// =====================================
model Deficiencia {
  id        Int     @id @default(autoincrement())
  tabla     String  @db.VarChar(10)
  nombre    String  @db.VarChar(255)
  capitulo  String? @db.VarChar(20)
  decreto   String? @db.VarChar(50)
  tipoTabla String? @map("tipo_tabla") @db.VarChar(50)

  nervios     DeficienciaNervio[]
  clases      DeficienciaClase[]
  movimientos DeficienciaMovimiento[]

  cie10Deficiencias    Cie10Deficiencia[]
  dictamenDeficiencias DictamenDeficiencia[]

  @@map("deficiencias")
}

// Tabla de nervios asociada a una deficiencia
model DeficienciaNervio {
  id            Int    @id @default(autoincrement())
  deficienciaId Int
  nombre        String @db.VarChar(255)

  motorA     Decimal? @map("motor_a") @db.Decimal(6, 2)
  sensitivoA Decimal? @map("sensitivo_a") @db.Decimal(6, 2)
  mixtoA     Decimal? @map("mixto_a") @db.Decimal(6, 2)
  motorB     Decimal? @map("motor_b") @db.Decimal(6, 2)
  sensitivoB Decimal? @map("sensitivo_b") @db.Decimal(6, 2)
  mixtoB     Decimal? @map("mixto_b") @db.Decimal(6, 2)
  orden      Int      @default(1)

  deficiencia Deficiencia @relation(fields: [deficienciaId], references: [id])

  dictamenDeficiencias DictamenDeficiencia[]

  @@index([deficienciaId])
  @@map("nervios")
}

// Tabla de clases asociada a una deficiencia
model DeficienciaClase {
  id            Int    @id @default(autoincrement())
  deficienciaId Int
  nombre        String @db.VarChar(255)

  procedimientoA Decimal? @map("procedimiento_a") @db.Decimal(6, 2)
  procedimientoB Decimal? @map("procedimiento_b") @db.Decimal(6, 2)
  orden          Int      @default(1)

  deficiencia          Deficiencia           @relation(fields: [deficienciaId], references: [id])
  dictamenDeficiencias DictamenDeficiencia[]

  @@index([deficienciaId])
  @@map("clases")
}

// Tabla de movimientos asociada a una deficiencia
model DeficienciaMovimiento {
  id            Int @id @default(autoincrement())
  deficienciaId Int

  tipoMovimiento String   @map("tipo_movimiento") @db.VarChar(255)
  rangoInicial   Decimal? @map("rango_inicial") @db.Decimal(6, 2)
  rangoFinal     Decimal? @map("rango_final") @db.Decimal(6, 2)

  restriccionA Decimal? @map("restriccion_a") @db.Decimal(6, 2)
  restriccionB Decimal? @map("restriccion_b") @db.Decimal(6, 2)
  anquilosisA  Decimal? @map("anquilosis_a") @db.Decimal(6, 2)
  anquilosisB  Decimal? @map("anquilosis_b") @db.Decimal(6, 2)

  grupo String? @db.VarChar(100)
  orden Int     @default(1)

  deficiencia Deficiencia @relation(fields: [deficienciaId], references: [id])

  dictamenMovimientos DictamenDeficienciaMovimiento[]

  @@index([deficienciaId])
  @@map("movimientos")
}

// =====================================
