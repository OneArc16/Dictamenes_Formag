// =====================================
// Configuración básica
// =====================================
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// =====================================
// ENUMS GENERALES
// =====================================
enum EstadoUsuario {
  ACTIVO
  INACTIVO
}

enum ConfirmacionTelefono {
  SIN_CONFIRMAR
  CONFIRMADO
}

// Procedimiento A / B del decreto
enum ProcedimientoPcl {
  A
  B
}

enum TratamientoProfesional {
  DR
  DRA
}

enum TipoDictamen {
  CALIFICACION
  RECALIFICACION
}

enum EstadoRecomendacionLaboral {
  BORRADOR
  REABIERTO
  CERRADA
  ANULADA
}

enum TipoHistorialRecomendacionLaboral {
  REAPERTURA
  EDICION
  CIERRE
}


// Modo de valoración para MOVIMIENTO
enum MovimientoModo {
  RESTRICCION
  ANQUILOSIS
}

enum TipoDiagnostico {
  CONFIRMADO_NUEVO
  IMPRESION_DIAGNOSTICA
  CONFIRMADO_REPETIDO
}

// Clase de limitación laboral como educador
enum ClaseLimitacionLaboral {
  I
  II
  III
  IV
}

// Gravedad Título III
enum GravedadAnalisis {
  CERO
  I
  II
  III
  IV
}

// Tipo de criterio de deficiencia
enum TipoCriterioDeficiencia {
  ENUM
  RANGE
  BOOLEAN
  NUMBER
}

// Unidad de criterio
enum UnidadCriterio {
  NONE
  DEGREE
  METS
  TNM_T
  TNM_N
  TNM_M
  SCORE
}

// Actividades AVD / AIVD (Título II, Cap.1)
enum ActividadAvdAivd {
  MIRAR
  ESCUCHAR
  PENSAR
  LEER
  ESCRIBIR
  COMUNICARSE_CON_MENSAJES_ESCRITOS
  HABLA
  PRODUCCION_MENSAJES_NO_VERBALES
  MENSAJES_ESCRITOS
  CONVERSACION
  MANTENER_CAMBIAR_POSICION_CUERPO
  USO_MANO_BRAZO
  DESPLAZARSE_ENTORNO
  USO_TRANSPORTE_PASAJERO
  CONDUCCION
  LAVARSE
  CUIDADO_PARTES_CUERPO
  VESTIRSE
  COMER
  BEBER
  ADQUIRIR_LO_NECESARIO_PARA_VIVIR
  ADQUIRIR_BIENES_SERVICIOS
  PREPARAR_COMIDAS
  QUEHACERES_CASA
  AYUDAR_A_LOS_DEMAS
}

// Factores del análisis ocupacional (Título III)
enum FactorAnalisisOcupacional {
  // Psicológicos
  ATENCION
  MEMORIA
  COMPRENSION_RESOLUCION_PROBLEMAS
  INICIATIVA_AUTONOMIA
  OBSERVACION
  CAPACIDAD_ANALISIS_SINTESIS
  COMPRENSION_ESPACIAL
  ADAPTACION
  RELACIONES
  TOMA_DECISIONES

  // Responsabilidad
  RESP_HERRAMIENTAS_EQUIPOS
  RESP_MATERIALES_PRODUCTOS
  RESP_INFORMACION_VALORES
  RESP_TRABAJO_OTROS
  RESP_SEGURIDAD_OTROS

  // Comunicación
  COMUNICACION_ORAL
  COMUNICACION_GESTUAL

  // Conocimientos académicos
  LECTURA
  ESCRITURA
  MATEMATICAS

  // Sensopercepción
  VISION
  PERCEPCION_COLOR
  PERCEPCION_FORMA
  PERCEPCION_TAMANO
  PERCEPCION_TEMPORAL
  ORIENTACION_ESPACIAL
  AUDICION
  UBICACION_FUENTE_SONORA
  DISCRIMINACION_AUDITIVA
  SENSIBILIDAD_SUPERFICIAL
  ESTEROGNOSIA
  BAROGNOSIA
  PROPIOCEPCION_SENTIDO_KINETICO
  OLFATO
  GUSTO

  // Motricidad gruesa
  DESPLAZAMIENTO
  TRANSPORTAR_PESO
  ALCANZAR
  HALAR
  EMPUJAR
  LEVANTAR
  POSICION_SENTADO
  SUPLENCIA_SENTADO
  POSICION_DE_PIE
  SUPLENCIA_DE_PIE
  POSICION_RODILLAS
  POSICION_CUCLILLAS
  EQUILIBRIO_ESTATICO

  // Motricidad fina
  AGARRE_MANO_LLENA
  AGARRE_CILINDRICO
  DIGITO_DIGITAL
  ENGANCHE
  PINZA_FINA
  PINZA_TRIPODE
  PINZA_LATERAL
  EXACTITUD
  PRECISION
  PULSO
  AGILIDAD
  DESTREZA_MANUAL
  DESTREZA_DIGITAL
  ARMONIA
}

enum DictamenTipoEvento {
  ENFERMEDAD
  ACCIDENTE
}

enum DictamenOrigenEvento {
  LABORAL
  COMUN
}

enum TipoHistorialDictamen {
  REAPERTURA
  EDICION
  CIERRE
}

enum EstadoHistorialDictamen {
  PENDIENTE
  REABIERTO
  CERRADO
}


// =====================================
// NUEVO: CARGOS DOCENTES (Usuario)
// =====================================
model CargoDocente {
  id     Int     @id @default(autoincrement())
  codigo String? @db.VarChar(20)
  nombre String  @db.Text
  estado Boolean @default(true)

  usuarios Usuario[]

  @@unique([nombre])
  @@index([codigo])
  @@map("cargos_docentes")
}

// =====================================
// NUEVO: ESPECIALIDADES MÉDICAS (Empleado)
// =====================================
model EspecialidadMedica {
  id     Int     @id @default(autoincrement())
  codigo String? @db.VarChar(20)
  nombre String  @db.VarChar(150)
  estado Boolean @default(true)

  empleados EmpleadoEspecialidad[]

  @@unique([nombre])
  @@index([codigo])
  @@map("especialidades_medicas")
}

model EmpleadoEspecialidad {
  id             Int @id @default(autoincrement())
  empleadoId     Int
  especialidadId Int

  principal Boolean @default(false)

  empleado     Empleado           @relation(fields: [empleadoId], references: [id], onDelete: Cascade)
  especialidad EspecialidadMedica @relation(fields: [especialidadId], references: [id], onDelete: Restrict)

  @@unique([empleadoId, especialidadId])
  @@index([empleadoId])
  @@index([especialidadId])
  @@map("empleado_especialidades")
}

// =====================================
// PAISES
// =====================================
model Pais {
  codigo         String @id @db.Char(3)
  nombre         String @db.VarChar(100)
  codigoTelefono String @db.Char(3)

  usuariosResidencia Usuario[] @relation("PaisResidencia")

  @@map("paises")
}

// =====================================
// DEPARTAMENTOS
// =====================================
model Departamento {
  codigo String @id @db.Char(2)
  nombre String @db.VarChar(50)

  municipios     Municipio[]            @relation("DepartamentoMunicipios")
  usuarios       Usuario[]              @relation("DepartamentoUsuarios")
  eps            Eps[]                  @relation("DepartamentoEps")
  centrosMedicos CentroMedico[]         @relation("DepartamentoCentroMedico")
  sedes          Sede[]                 @relation("DepartamentoSedes")
  instituciones  InstitucionEducativa[] @relation("DepartamentoInstituciones")

  @@map("departamentos")
}

// =====================================
// MUNICIPIOS
// =====================================
model Municipio {
  codigo             String @id @db.Char(5)
  nombre             String @db.VarChar(100)
  codigoDepartamento String @db.Char(2)

  departamento Departamento @relation("DepartamentoMunicipios", fields: [codigoDepartamento], references: [codigo])

  usuarios      Usuario[]              @relation("MunicipioUsuarios")
  eps           Eps[]                  @relation("MunicipioEps")
  barrios       Barrio[]               @relation("MunicipioBarrios")
  centrosMedicos CentroMedico[]        @relation("MunicipioCentroMedico")
  sedes         Sede[]                 @relation("MunicipioSedes")
  instituciones InstitucionEducativa[] @relation("MunicipioInstituciones")

  @@index([codigoDepartamento])
  @@map("municipios")
}

// =====================================
// BARRIOS
// =====================================
model Barrio {
  id              Int    @id @default(autoincrement())
  nombre          String @db.VarChar(100)
  codigoMunicipio String @db.Char(5)

  localidad    String? @db.VarChar(100)
  codigoPostal String? @db.VarChar(10)
  comuna       String? @db.VarChar(50)

  municipio Municipio @relation("MunicipioBarrios", fields: [codigoMunicipio], references: [codigo])

  usuarios Usuario[] @relation("BarrioUsuarios")

  @@unique([codigoMunicipio, nombre])
  @@index([codigoMunicipio])
  @@map("barrios")
}

// =====================================
// EPS
// =====================================
model Eps {
  codigo             String  @id @db.VarChar(6)
  nombreEntidad      String  @db.VarChar(255)
  codigoDepartamento String? @db.Char(2)
  codigoMunicipio    String? @db.Char(5)
  digitado           Boolean @default(false)
  nit                String  @unique @db.VarChar(15)
  dv                 String  @db.Char(1)
  email              String  @db.VarChar(80)
  telefono           String  @db.VarChar(15)
  direccion          String  @db.VarChar(100)

  departamento Departamento? @relation("DepartamentoEps", fields: [codigoDepartamento], references: [codigo])
  municipio    Municipio?    @relation("MunicipioEps", fields: [codigoMunicipio], references: [codigo])

  usuarios Usuario[] @relation("EpsUsuarios")

  @@index([codigoDepartamento])
  @@index([codigoMunicipio])
  @@map("eps")
}

// =====================================
// CENTRO MÉDICO
// =====================================
model CentroMedico {
  id                 Int     @id @default(autoincrement())
  codigoHabilitacion String  @db.VarChar(255)
  nombre             String  @db.VarChar(255)
  email              String? @db.VarChar(100)
  direccion          String? @db.VarChar(100)
  telefono           String? @db.VarChar(20)
  codigoDepartamento String? @db.Char(2)
  codigoMunicipio    String? @db.Char(5)
  logo               Bytes?
  estado             Int     @default(1) @db.SmallInt
  resolucion         String? @db.VarChar(50)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  createdBy String?  @db.VarChar(100)
  updatedBy String?  @db.VarChar(100)

  departamento Departamento? @relation("DepartamentoCentroMedico", fields: [codigoDepartamento], references: [codigo])
  municipio    Municipio?    @relation("MunicipioCentroMedico", fields: [codigoMunicipio], references: [codigo])

  sedes Sede[]

  @@index([codigoDepartamento])
  @@index([codigoMunicipio])
  @@map("centro_medico")
}

// =====================================
// SEDES
// =====================================
model Sede {
  id                 Int     @id @default(autoincrement())
  centroMedicoId     Int
  nombre             String  @db.VarChar(100)
  codigoHabilitacion String? @db.VarChar(50)
  direccion          String? @db.VarChar(225)
  codigoDepartamento String? @db.Char(2)
  codigoMunicipio    String? @db.Char(5)
  telefono           String? @db.VarChar(50)
  estado             Int     @default(1) @db.SmallInt

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  createdBy String?  @db.VarChar(100)
  updatedBy String?  @db.VarChar(100)

  centroMedico CentroMedico @relation(fields: [centroMedicoId], references: [id])

  departamento Departamento? @relation("DepartamentoSedes", fields: [codigoDepartamento], references: [codigo])
  municipio    Municipio?    @relation("MunicipioSedes", fields: [codigoMunicipio], references: [codigo])

  @@index([centroMedicoId])
  @@index([codigoDepartamento])
  @@index([codigoMunicipio])
  @@map("sedes")
}

// =====================================
// SECRETARÍAS DE EDUCACIÓN
// =====================================
model Secretaria {
  id     Int    @id @default(autoincrement())
  nombre String @db.VarChar(150)

  usuarios      Usuario[]              @relation("SecretariaUsuarios")
  instituciones InstitucionEducativa[] @relation("SecretariaInstituciones")

  @@map("secretarias")
}

// =====================================
// INSTITUCIONES EDUCATIVAS
// =====================================
model InstitucionEducativa {
  id     Int    @id @default(autoincrement())
  nombre String @db.VarChar(150)

  idDepartamento String? @db.Char(2) @map("id_departamento")
  idMunicipio    String? @db.Char(5) @map("id_municipio")
  idSecretaria   Int?    @map("id_secretaria")

  codigoIed String? @db.VarChar(20) @map("codigo_ied")

  direccion String? @db.VarChar(255)

  departamento Departamento? @relation("DepartamentoInstituciones", fields: [idDepartamento], references: [codigo])
  municipio    Municipio?    @relation("MunicipioInstituciones", fields: [idMunicipio], references: [codigo])
  secretaria   Secretaria?   @relation("SecretariaInstituciones", fields: [idSecretaria], references: [id])

  usuarios Usuario[] @relation("InstitucionUsuarios")

  @@index([idDepartamento])
  @@index([idMunicipio])
  @@index([idSecretaria])
  @@map("instituciones_educativas")
}

// =====================================
// PERFILES
// =====================================
model Perfil {
  id     Int    @id @default(autoincrement())
  nombre String @unique @db.VarChar(100)
  estado Int    @default(1) @db.SmallInt

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  createdBy String?  @db.VarChar(100)
  updatedBy String?  @db.VarChar(100)

  empleados Empleado[]

  @@map("perfiles")
}

// =====================================
// USUARIOS
// =====================================
model Usuario {
  id Int @id @default(autoincrement())

  carnet             String @db.VarChar(50)
  identificacion     String @db.VarChar(20)
  tipoIdentificacion String @db.Char(2)

  primerApellido  String  @db.VarChar(50)
  segundoApellido String? @db.VarChar(50)
  primerNombre    String  @db.VarChar(50)
  segundoNombre   String? @db.VarChar(50)

  direccion   String? @db.VarChar(255)
  telefono    String? @db.VarChar(15)
  tipoUsuario String  @db.Char(2)

  codigoOcupacion String? @db.Char(4)

  cargoDocenteId Int?          @map("cargo_docente_id")
  cargoDocente   CargoDocente? @relation(fields: [cargoDocenteId], references: [id])

  unidadEdad String @db.Char(1)
  edad       Int?   @db.SmallInt

  sexo String @db.Char(1)

  residenciaPais String @db.Char(3)
  paisResidencia Pais   @relation("PaisResidencia", fields: [residenciaPais], references: [codigo])

  zonaResidencia String @db.Char(1)

  fechaNacimiento DateTime? @db.Date

  estadoCivil String?       @db.VarChar(20)
  estado      EstadoUsuario @default(ACTIVO)
  fechaEstado DateTime?     @db.Date

  sector String @db.VarChar(50)

  nombreAcudiente   String? @db.VarChar(100)
  telefonoAcudiente String? @db.VarChar(15)
  hemoclasificacion String? @db.VarChar(3)
  parentezco        String? @db.Char(1)

  discapacidad Boolean @default(false)
  estrato      Int?    @db.SmallInt

  codigoEps String @db.VarChar(6)
  eps       Eps    @relation("EpsUsuarios", fields: [codigoEps], references: [codigo])

  categoria       String? @db.VarChar(30)
  etnia           String? @db.VarChar(10)
  lugarNacimiento String? @db.VarChar(5)

  nroHijos    Int     @default(0) @db.SmallInt
  escolaridad String? @db.Text

  fechaVinculacion DateTime? @db.Date @map("fecha_vinculacion")
  fechaAfiliacion  DateTime  @default(now())

  celular            String? @db.VarChar(15)
  email              String? @db.VarChar(100)
  religion           String? @db.VarChar(50)
  telefonoSecundario String? @db.VarChar(15)

  createdAt DateTime @default(now())
  createdBy String?  @db.VarChar(100)
  updatedAt DateTime @updatedAt
  updatedBy String?  @db.VarChar(100)

  genero    String? @db.VarChar(20)
  gestacion Boolean @default(false)

  victimaConflictoArmado Boolean @default(false)
  victimaMaltrato        Boolean @default(false)
  abandonoSocial         Boolean @default(false)
  desescolarizado        Boolean @default(false)
  desempleado            Boolean @default(false)
  carcelario             Boolean @default(false)
  migrante               Boolean @default(false)
  trabajadoraSexual      Boolean @default(false)
  poblacionLgtbi         Boolean @default(false)

  orientacionSexual String @default("NO REFIERE") @db.VarChar(50)

  barrio String? @db.VarChar(50)

  barrioId  Int?
  barrioRef Barrio? @relation("BarrioUsuarios", fields: [barrioId], references: [id])

  confirmacionTelefono ConfirmacionTelefono @default(SIN_CONFIRMAR)

  codigoDepartamento String? @db.Char(2)
  codigoMunicipio    String? @db.Char(5)
  codigoPais         String  @default("057") @db.Char(3)

  idSede Int?

  gradoEscalafon   String @db.VarChar(2)
  nivelEscalafon   String @db.VarChar(1)
  formaVinculacion String @db.VarChar(45)

  secretariaId  Int?
  secretariaRef Secretaria? @relation("SecretariaUsuarios", fields: [secretariaId], references: [id])

  institucionEducativaId  Int?
  institucionEducativaRef InstitucionEducativa? @relation("InstitucionUsuarios", fields: [institucionEducativaId], references: [id])

  departamento Departamento? @relation("DepartamentoUsuarios", fields: [codigoDepartamento], references: [codigo])
  municipio    Municipio?    @relation("MunicipioUsuarios", fields: [codigoMunicipio], references: [codigo])

  dictamenes               Dictamen[]
  recomendacionesLaborales RecomendacionLaboral[] @relation("UsuarioRecomendacionesLaborales")

  @@unique([identificacion, tipoIdentificacion])
  @@index([codigoEps])
  @@index([codigoDepartamento])
  @@index([codigoMunicipio])
  @@index([email])
  @@index([cargoDocenteId])
  @@map("usuarios")
}

// =====================================
// EMPLEADOS
// =====================================
model Empleado {
  id Int @id @default(autoincrement())

  tipoDocumento   String? @db.VarChar(3)
  numeroIdentidad String? @db.VarChar(18)

  primerNombre    String  @db.VarChar(40)
  segundoNombre   String? @db.VarChar(40)
  primerApellido  String  @db.VarChar(40)
  segundoApellido String? @db.VarChar(40)

  direccion String? @db.VarChar(50)
  telefonos String? @db.VarChar(30)

  contrasena String? @db.VarChar(60)

  activo Boolean @default(true)

  registroMedico String? @db.VarChar(25)
  licencia       String? @db.VarChar(30)

  tratamiento TratamientoProfesional @default(DR) @map("tratamiento")

  perfilId Int?
  perfil   Perfil? @relation(fields: [perfilId], references: [id])

  firma     Bytes?
  firmaMime String? @db.VarChar(50) @map("firma_mime")

  esMiembroJunta Boolean @default(false) @map("es_miembro_junta")

  email  String? @db.VarChar(50)
  idSede Int?

  especialidades EmpleadoEspecialidad[]

  dictamenes          Dictamen[]         @relation("EmpleadoDictamenesResponsable")
  dictamenesReabiertos Dictamen[]        @relation("EmpleadoReaberturasDictamenes")
  historialDictamenes DictamenHistorial[] @relation("EmpleadoHistorialDictamenes")
  dictamenJunta       DictamenJunta[]

  recomendacionesLaborales   RecomendacionLaboral[]      @relation("EmpleadoRecomendacionesLaborales")
  recomendacionLaboralFirmas RecomendacionLaboralFirma[] @relation("EmpleadoFirmasRecomendacionLaboral")

  recomendacionesReabiertas RecomendacionLaboral[]          @relation("EmpleadoReaberturasRecomendacionesLaborales")
  historialRecomendaciones  RecomendacionLaboralHistorial[] @relation("EmpleadoHistorialRecomendacionesLaborales")


  @@unique([tipoDocumento, numeroIdentidad])
  @@unique([email])
  @@index([esMiembroJunta])

  @@map("empleados")
}

// =====================================
// CATÁLOGO DE DEFICIENCIAS
// =====================================
model Deficiencia {
  id        Int     @id @default(autoincrement())
  tabla     String  @db.VarChar(10)
  nombre    String  @db.VarChar(255)
  capitulo  String? @db.VarChar(20)
  decreto   String? @db.VarChar(50)
  tipoTabla String? @db.VarChar(50) @map("tipo_tabla")

  nervios     DeficienciaNervio[]
  clases      DeficienciaClase[]
  movimientos DeficienciaMovimiento[]

  cie10Deficiencias    Cie10Deficiencia[]
  dictamenDeficiencias DictamenDeficiencia[]

  @@map("deficiencias")
}

// Tabla de nervios asociada a una deficiencia
model DeficienciaNervio {
  id            Int    @id @default(autoincrement())
  deficienciaId Int
  nombre        String @db.VarChar(255)

  motorA     Decimal? @db.Decimal(6, 2) @map("motor_a")
  sensitivoA Decimal? @db.Decimal(6, 2) @map("sensitivo_a")
  mixtoA     Decimal? @db.Decimal(6, 2) @map("mixto_a")
  motorB     Decimal? @db.Decimal(6, 2) @map("motor_b")
  sensitivoB Decimal? @db.Decimal(6, 2) @map("sensitivo_b")
  mixtoB     Decimal? @db.Decimal(6, 2) @map("mixto_b")
  orden      Int      @default(1)

  deficiencia Deficiencia @relation(fields: [deficienciaId], references: [id])

  dictamenDeficiencias DictamenDeficiencia[]

  @@index([deficienciaId])
  @@map("nervios")
}

// Tabla de clases asociada a una deficiencia
model DeficienciaClase {
  id            Int    @id @default(autoincrement())
  deficienciaId Int
  nombre        String @db.VarChar(255)

  procedimientoA Decimal? @db.Decimal(6, 2) @map("procedimiento_a")
  procedimientoB Decimal? @db.Decimal(6, 2) @map("procedimiento_b")
  orden          Int      @default(1)

  deficiencia          Deficiencia         @relation(fields: [deficienciaId], references: [id])
  dictamenDeficiencias DictamenDeficiencia[]

  @@index([deficienciaId])
  @@map("clases")
}

// Tabla de movimientos asociada a una deficiencia
model DeficienciaMovimiento {
  id            Int @id @default(autoincrement())
  deficienciaId Int

  tipoMovimiento String   @db.VarChar(255) @map("tipo_movimiento")
  rangoInicial   Decimal? @db.Decimal(6, 2) @map("rango_inicial")
  rangoFinal     Decimal? @db.Decimal(6, 2) @map("rango_final")

  restriccionA Decimal? @db.Decimal(6, 2) @map("restriccion_a")
  restriccionB Decimal? @db.Decimal(6, 2) @map("restriccion_b")
  anquilosisA  Decimal? @db.Decimal(6, 2) @map("anquilosis_a")
  anquilosisB  Decimal? @db.Decimal(6, 2) @map("anquilosis_b")

  grupo String? @db.VarChar(100)
  orden Int     @default(1)

  deficiencia Deficiencia @relation(fields: [deficienciaId], references: [id])

  dictamenMovimientos DictamenDeficienciaMovimiento[]

  @@index([deficienciaId])
  @@map("movimientos")
}

// =====================================
// CIE10 y vínculo con Deficiencia
// =====================================
model Cie10 {
  codigo String  @id @db.VarChar(10)
  nombre String  @db.VarChar(255)
  estado Boolean @default(true)

  cie10Deficiencias    Cie10Deficiencia[]
  dictamenDiagnosticos DictamenDiagnostico[]

  @@map("cie10")
}

model Cie10Deficiencia {
  cie10Codigo   String @db.VarChar(10)
  deficienciaId Int

  cie10       Cie10       @relation(fields: [cie10Codigo], references: [codigo])
  deficiencia Deficiencia @relation(fields: [deficienciaId], references: [id])

  @@id([cie10Codigo, deficienciaId])
  @@index([deficienciaId])
  @@map("cie10_deficiencias")
}

// =====================================
// DICTAMEN
// =====================================
model Dictamen {
  id               Int              @id @default(autoincrement())
  usuarioId        Int
  numeroDictamen   String?          @db.VarChar(30)
  fechaDictamen    DateTime         @db.Date
  creadoEn         DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
  procedimientoPcl ProcedimientoPcl

  tipoDictamen TipoDictamen @default(CALIFICACION) @map("tipo_dictamen")

  totalTitulo1           Decimal?                @db.Decimal(6, 2)
  totalCap1              Decimal?                @db.Decimal(6, 2)
  claseLimitacionLaboral ClaseLimitacionLaboral?
  totalCap2              Decimal?                @db.Decimal(6, 2)
  totalTitulo3           Decimal?                @db.Decimal(6, 2)

  antecedentesClinicos String?
  condicionSalud       String?
  descripcionHallazgos String?

  sustentacionObservaciones String? @db.Text

  fechaEstructuracionInvalidez DateTime?
  tipoEvento                   DictamenTipoEvento?
  origenEvento                 DictamenOrigenEvento?

  aplicaAnalisisOcupacional Boolean @default(false)
  estado                    Boolean @default(true)
  reabierto                 Boolean @default(false)

  reabiertoEn       DateTime? @map("reabierto_en")
  reabiertoPorId    Int?      @map("reabierto_por_id")
  motivoReaperturaId Int?     @map("motivo_reapertura_id")

  empleadoId Int?
  empleado   Empleado? @relation("EmpleadoDictamenesResponsable", fields: [empleadoId], references: [id])

  reabiertoPor Empleado?        @relation("EmpleadoReaberturasDictamenes", fields: [reabiertoPorId], references: [id])
  motivoReapertura MotivoReapertura? @relation("MotivoReaperturaActualDictamen", fields: [motivoReaperturaId], references: [id])

  usuario Usuario @relation(fields: [usuarioId], references: [id])

  diagnosticos        DictamenDiagnostico[]
  deficiencias        DictamenDeficiencia[]
  limitacionesAvdAivd DictamenLimitacionesAvdAivd[]
  analisisOcupacional DictamenAnalisisOcupacional[]

  junta     DictamenJunta[]
  historial DictamenHistorial[]

  @@index([usuarioId])
  @@index([empleadoId])
  @@index([reabiertoPorId])
  @@index([motivoReaperturaId])
  @@index([tipoDictamen])
  @@index([estado, reabierto, fechaDictamen])
  @@map("dictamenes")
}


// =====================================
// Snapshots de junta por dictamen
// =====================================
model DictamenJunta {
  id         Int  @id @default(autoincrement())
  dictamenId Int  @map("dictamen_id")
  empleadoId Int? @map("empleado_id")

  nombreCompleto String  @db.VarChar(150) @map("nombre_completo")
  registroMedico String? @db.VarChar(25) @map("registro_medico")
  licencia       String? @db.VarChar(30) @map("licencia")
  firma          Bytes?  @map("firma")
  firmaMime      String? @db.VarChar(50) @map("firma_mime")

  orden     Int      @default(1)
  cerradoEn DateTime @default(now()) @map("cerrado_en")

  dictamen Dictamen  @relation(fields: [dictamenId], references: [id], onDelete: Cascade)
  empleado Empleado? @relation(fields: [empleadoId], references: [id], onDelete: SetNull)

  @@unique([dictamenId, orden])
  @@index([dictamenId])
  @@index([empleadoId])
  @@map("dictamen_junta")
}

// =====================================
// RECOMENDACIONES MÉDICO-LABORALES
// =====================================
model RecomendacionLaboral {
  id Int @id @default(autoincrement())

  usuarioId  Int
  empleadoId Int?

  numeroRecomendacion String?  @db.VarChar(30)
  fechaRecomendacion  DateTime @db.Date

  pesoKg Decimal? @db.Decimal(5, 2) @map("peso_kg")
  tallaM Decimal? @db.Decimal(4, 2) @map("talla_m")
  imc    Decimal? @db.Decimal(5, 2)

  examenesRealizados                         String? @db.Text @map("examenes_realizados")
  motivo                                     String? @db.Text
  recomendacionesObservacionesRestricciones  String? @db.Text @map("recomendaciones_observaciones_restricciones")

  estado EstadoRecomendacionLaboral @default(BORRADOR)

  cerradaEn    DateTime? @map("cerrada_en")
  reabiertaEn  DateTime? @map("reabierta_en")

  reabiertaPorId     Int? @map("reabierta_por_id")
  motivoReaperturaId Int? @map("motivo_reapertura_id")

  creadoEn  DateTime @default(now()) @map("creado_en")
  updatedAt DateTime @updatedAt

  usuario  Usuario   @relation("UsuarioRecomendacionesLaborales", fields: [usuarioId], references: [id])
  empleado Empleado? @relation("EmpleadoRecomendacionesLaborales", fields: [empleadoId], references: [id])

  reabiertaPor     Empleado?         @relation("EmpleadoReaberturasRecomendacionesLaborales", fields: [reabiertaPorId], references: [id])
  motivoReapertura MotivoReapertura? @relation("MotivoReaperturaActualRecomendacionLaboral", fields: [motivoReaperturaId], references: [id])

  firmas    RecomendacionLaboralFirma[]
  historial RecomendacionLaboralHistorial[]

  @@index([usuarioId])
  @@index([empleadoId])
  @@index([reabiertaPorId])
  @@index([motivoReaperturaId])
  @@index([estado, fechaRecomendacion])
  @@map("recomendaciones_laborales")
}


model RecomendacionLaboralHistorial {
  id Int @id @default(autoincrement())

  recomendacionLaboralId Int  @map("recomendacion_laboral_id")
  empleadoId             Int? @map("empleado_id")
  motivoReaperturaId     Int? @map("motivo_reapertura_id")

  tipo TipoHistorialRecomendacionLaboral

  estadoAnterior EstadoRecomendacionLaboral? @map("estado_anterior")
  estadoNuevo    EstadoRecomendacionLaboral? @map("estado_nuevo")

  formularioAnterior Json? @map("formulario_anterior")
  formularioNuevo    Json? @map("formulario_nuevo")

  createdAt DateTime @default(now()) @map("created_at")

  recomendacionLaboral RecomendacionLaboral @relation(fields: [recomendacionLaboralId], references: [id], onDelete: Cascade)
  empleado             Empleado?            @relation("EmpleadoHistorialRecomendacionesLaborales", fields: [empleadoId], references: [id], onDelete: SetNull)
  motivoReapertura     MotivoReapertura?    @relation("MotivoReaperturaHistorialRecomendacionLaboral", fields: [motivoReaperturaId], references: [id], onDelete: SetNull)

  @@index([recomendacionLaboralId])
  @@index([empleadoId])
  @@index([motivoReaperturaId])
  @@index([tipo, createdAt])
  @@map("recomendaciones_laborales_historial")
}



model RecomendacionLaboralFirma {
  id Int @id @default(autoincrement())

  recomendacionLaboralId Int  @map("recomendacion_laboral_id")
  empleadoId             Int? @map("empleado_id")

  nombreCompleto String  @db.VarChar(150) @map("nombre_completo")
  registroMedico String? @db.VarChar(25) @map("registro_medico")
  licencia       String? @db.VarChar(30)
  firma          Bytes?
  firmaMime      String? @db.VarChar(50) @map("firma_mime")

  orden     Int      @default(1)
  cerradoEn DateTime @default(now()) @map("cerrado_en")

  recomendacionLaboral RecomendacionLaboral @relation(fields: [recomendacionLaboralId], references: [id], onDelete: Cascade)
  empleado             Empleado?            @relation("EmpleadoFirmasRecomendacionLaboral", fields: [empleadoId], references: [id], onDelete: SetNull)

  @@unique([recomendacionLaboralId, orden])
  @@index([recomendacionLaboralId])
  @@index([empleadoId])
  @@map("recomendacion_laboral_firmas")
}

model MotivoReapertura {
  id          Int     @id @default(autoincrement())
  codigo      String? @db.VarChar(20)
  nombre      String  @db.VarChar(150)
  descripcion String? @db.Text
  estado      Boolean @default(true)
  orden       Int     @default(1)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  createdBy String?  @db.VarChar(100)
  updatedBy String?  @db.VarChar(100)

  recomendacionesReabiertas RecomendacionLaboral[]          @relation("MotivoReaperturaActualRecomendacionLaboral")
  historialRecomendaciones  RecomendacionLaboralHistorial[] @relation("MotivoReaperturaHistorialRecomendacionLaboral")

  dictamenesReabiertos Dictamen[]           @relation("MotivoReaperturaActualDictamen")
  historialDictamenes  DictamenHistorial[]  @relation("MotivoReaperturaHistorialDictamen")

  @@unique([nombre])
  @@index([codigo])
  @@index([estado, orden])
  @@map("motivos_reapertura_recomendacion")
}

model DictamenHistorial {
  id Int @id @default(autoincrement())

  dictamenId           Int  @map("dictamen_id")
  empleadoId           Int? @map("empleado_id")
  motivoReaperturaId   Int? @map("motivo_reapertura_id")

  tipo TipoHistorialDictamen

  estadoAnterior EstadoHistorialDictamen? @map("estado_anterior")
  estadoNuevo    EstadoHistorialDictamen? @map("estado_nuevo")

  formularioAnterior Json? @map("formulario_anterior")
  formularioNuevo    Json? @map("formulario_nuevo")

  createdAt DateTime @default(now()) @map("created_at")

  dictamen         Dictamen           @relation(fields: [dictamenId], references: [id], onDelete: Cascade)
  empleado         Empleado?          @relation("EmpleadoHistorialDictamenes", fields: [empleadoId], references: [id], onDelete: SetNull)
  motivoReapertura MotivoReapertura?  @relation("MotivoReaperturaHistorialDictamen", fields: [motivoReaperturaId], references: [id], onDelete: SetNull)

  @@index([dictamenId])
  @@index([empleadoId])
  @@index([motivoReaperturaId])
  @@index([tipo, createdAt])
  @@map("dictamenes_historial")
}

model DictamenDiagnostico {
  id         Int             @id @default(autoincrement())
  dictamenId Int
  cie10Codigo String         @db.VarChar(10)
  tipo       TipoDiagnostico @default(IMPRESION_DIAGNOSTICA)

  dictamen Dictamen @relation(fields: [dictamenId], references: [id])
  cie10    Cie10    @relation(fields: [cie10Codigo], references: [codigo])

  @@index([dictamenId])
  @@index([cie10Codigo])
  @@map("dictamen_diagnosticos")
}

model DictamenDeficiencia {
  id            Int @id @default(autoincrement())
  dictamenId    Int
  deficienciaId Int
  claseId       Int? @map("id_clase")
  nervioId      Int? @map("id_nervio")

  valorDeficiencia Decimal? @db.Decimal(6, 2)
  creadoEn         DateTime @default(now())

  dictamen    Dictamen           @relation(fields: [dictamenId], references: [id])
  deficiencia Deficiencia        @relation(fields: [deficienciaId], references: [id])
  clase       DeficienciaClase?  @relation(fields: [claseId], references: [id])
  nervio      DeficienciaNervio? @relation(fields: [nervioId], references: [id])

  movimientos DictamenDeficienciaMovimiento[]

  @@index([dictamenId])
  @@index([deficienciaId])
  @@index([claseId])
  @@index([nervioId])
  @@map("dictamen_deficiencias")
}

model DictamenDeficienciaMovimiento {
  id Int @id @default(autoincrement())

  dictamenDeficienciaId Int @map("dictamen_deficiencia_id")
  movimientoId          Int @map("movimiento_id")

  tipoMovimiento String @db.VarChar(255) @map("tipo_movimiento")

  modo  MovimientoModo
  valor Decimal? @db.Decimal(6, 2)

  creadoEn DateTime @default(now()) @map("creado_en")

  dictamenDeficiencia DictamenDeficiencia   @relation(fields: [dictamenDeficienciaId], references: [id], onDelete: Cascade)
  movimiento          DeficienciaMovimiento @relation(fields: [movimientoId], references: [id])

  @@unique([dictamenDeficienciaId, tipoMovimiento])
  @@index([dictamenDeficienciaId])
  @@index([movimientoId])
  @@map("dictamen_deficiencia_movimientos")
}

// TÍTULO II – Cap. 1
model DictamenLimitacionesAvdAivd {
  id         Int             @id @default(autoincrement())
  dictamenId Int
  actividad  ActividadAvdAivd
  valor      Decimal         @db.Decimal(3, 1)

  dictamen Dictamen @relation(fields: [dictamenId], references: [id])

  @@unique([dictamenId, actividad])
  @@index([dictamenId])
  @@map("dictamen_limitaciones_avd_aivd")
}

// TÍTULO III – Análisis ocupacional
model DictamenAnalisisOcupacional {
  id         Int @id @default(autoincrement())
  dictamenId Int
  factor     FactorAnalisisOcupacional
  gravedad   GravedadAnalisis
  valor      Int?

  dictamen Dictamen @relation(fields: [dictamenId], references: [id])

  @@unique([dictamenId, factor])
  @@index([dictamenId])
  @@map("dictamen_analisis_ocupacional")
}