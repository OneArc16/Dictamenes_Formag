generator client {
  provider = "prisma-client-js"
  output   = "../generated/app"
}

datasource db {
  provider = "postgresql"
  url      = env("APP_DATABASE_URL")
}

enum Role {
  ADMIN
  ADMISIONISTA
  MEDICO
}

model StaffOverride {
  id             String   @id @default(cuid())
  empleadoCodigo String
  documento      String
  nombre         String?
  roleOverride   Role?
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([empleadoCodigo, documento])
}

model LoginAudit {
  id             String   @id @default(cuid())
  empleadoCodigo String
  documento      String
  success        Boolean
  ip             String?
  userAgent      String?
  createdAt      DateTime @default(now())
}